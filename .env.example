# =====================================================================
# .env.example · BULON (sistema-taller)
# Este archivo es una PLANTILLA: solo nombres de variables, sin valores.
#
# Hoy el demo NO necesita ninguna variable: corre con datos de ejemplo.
# Cuando conectes el backend real (ver docs/IMPLEMENTAR.md):
#   1. Copiá este archivo:   cp .env.example .env.local
#   2. Completá los valores en .env.local (ese archivo NO se sube a Git).
#   3. En Vercel, cargá las mismas variables en Project Settings > Environment Variables.
# NUNCA escribas valores reales en este archivo ni lo uses para guardar secretos.
# =====================================================================

# --- Supabase (base de datos + Auth) ---------------------------------
# URL del proyecto. Panel de Supabase > Connect (o Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
# Clave PUBLICA (en el panel puede llamarse "anon" o "publishable key").
# Es segura en el navegador SOLO si tenés RLS activado en todas las tablas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Solo servidor (nunca con prefijo NEXT_PUBLIC_) -------------------
# Clave secreta de Supabase ("service_role" o "secret key"): se salta el RLS.
# JAMAS va al frontend ni a Vercel como NEXT_PUBLIC_*. No la necesitás para
# empezar: la usa solo el script de carga inicial y el worker de Railway.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (elegí un proveedor; la clave vive solo en el servidor) --------
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Worker de Railway (NO va en este proyecto de Vercel) -------------
# Cadena de conexion a Postgres para pg-boss. Se carga en las variables del
# servicio del worker en Railway. Detalle en docs/IMPLEMENTAR.md, seccion 4.
# DATABASE_URL=
